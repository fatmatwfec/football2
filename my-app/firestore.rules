rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: allow authenticated users to read (public) and maintain their own profile.
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      function validUser() {
        return request.resource.data.keys().hasAll(['name', 'studentCode', 'email', 'role', 'hasTeam', 'createdAt'])
          && request.resource.data.studentCode is string
          && request.resource.data.hasTeam is bool;
      }

      allow create, update: if validUser();
    }

    // Teams: only authenticated users may create/update team data.
    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      function validTeam() {
        return request.resource.data.teamName is string
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && (request.resource.data.members is list || request.resource.data.memberIds is list)
          && (request.resource.data.memberIds == null || request.resource.data.memberIds.size() <= 7)
          && request.resource.data.members.size() <= 7;
      }

      allow create, update: if validTeam();
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
